FROM docker.io/oven/bun:1

WORKDIR /app

# Queries run in an isolated host-managed executor, never in the API container.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssh-client \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile --production

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts

# Runtime datasets are mounted here (see compose.yaml and datasets/README.md)
RUN mkdir -p datasets && chown -R bun:bun /app
USER bun

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["bun", "run", "src/index.ts"]
