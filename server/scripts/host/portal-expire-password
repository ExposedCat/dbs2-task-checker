#!/usr/bin/env bash
# Expires the Linux password of one student account so that a new password must be chosen at
# the next login (`passwd -e`). Installed root-owned in /usr/local/libexec and allowed for the
# infrastructure user through sudoers without a password (see README.md in this directory).
set -euo pipefail

login=${1:-}
if [[ ! $login =~ ^f[0-9]{2}_[a-z0-9_]{1,43}$ ]]; then
  echo "refused: '$login' is not a student login" >&2
  exit 2
fi
if ! id -u "$login" >/dev/null 2>&1; then
  echo "no such Linux account: $login" >&2
  exit 3
fi

passwd -e "$login" >/dev/null
echo "Password of $login expired: a new one must be set at the next login"
