# Local development settings (`bun run dev`). Inside compose these are set in compose.yaml.

# Secret used to sign session JWTs. Required.
JWT_SECRET=change-me

# Port the API listens on
PORT=8080

# Portal database (users, datasets, submissions)
DB_CONNECTION_URL=mongodb://127.0.0.1:27017

# Sandbox MongoDB where student queries are executed (one database + user per student)
MONGO_SANDBOX_HOST=127.0.0.1
MONGO_SANDBOX_PORT=42222

# Host of the sandbox Redis instances (one instance per student, on `user.port`)
REDIS_SANDBOX_HOST=127.0.0.1

# Only used by `scripts/create-user.ts` to provision the student's sandbox MongoDB user
# MONGO_SANDBOX_ROOT_URL=mongodb://root:change-me@127.0.0.1:42222
