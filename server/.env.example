# Direct API development; start the host broker first (scripts/grading/README.md).
JWT_SECRET=change-me
PORT=8080
DB_CONNECTION_URL=mongodb://127.0.0.1:27017
GRADING_BROKER_SOCKET=/absolute/path/to/grading/control/broker.sock
REDIS_GRADING_SOCKET=/absolute/path/to/redis.sock
PORTAL_LOGIN_SOCKET=/absolute/private/path/to/approve.sock
PORTAL_LOGIN_COMMAND=portal-login
REFERENCE_CACHE_VERSION=executor-v1
