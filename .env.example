# Copy to .env and adjust. Read by podman-compose / docker compose.

# Secret used to sign session JWTs (e.g. `openssl rand -hex 32`). Required.
JWT_SECRET=change-me

# ---------------------------------------------------------------------------------------
# Databases already running on the host (default mode, e.g. nosql.felk.cvut.cz).
# `host.containers.internal` resolves to the host machine from inside the containers, so
# ports published by other containers on the host are reachable through it.
# ---------------------------------------------------------------------------------------

# Portal database: users, question banks, submissions.
# nosql.felk.cvut.cz: the `portal` database of the yuliia-mongodb container (host port 42222)
DB_CONNECTION_URL=mongodb://admin:change-me@host.containers.internal:42222

# Personal MongoDB endpoint, used only for admin Services monitoring.
# nosql.felk.cvut.cz: the same yuliia-mongodb container
MONGO_SANDBOX_HOST=host.containers.internal
MONGO_SANDBOX_PORT=42222

# Personal Redis endpoint for Services monitoring only; grading uses a private Unix socket.
# nosql.felk.cvut.cz: the yuliia-redis-<login> containers (managed by ~/infra/redis/manage)
REDIS_SANDBOX_HOST=host.containers.internal

# Password reset of student Linux accounts from the Users page (server/scripts/host/README.md).
# Leave the target empty to disable the feature.
PASSWORD_RESET_SSH_TARGET=yuliia@host.containers.internal
PASSWORD_RESET_SSH_KEY_FILE=./secrets/portal_ssh_key

# Extra services checked on the admin Services page, comma separated: Name=tcp://host:port
# (port accepts connections) or Name=http://host:port/ (answers 2xx/3xx). The portal and
# sandbox MongoDB and all student Redis instances are checked without being listed here.
INFRA_SERVICES="PostgreSQL=tcp://host.containers.internal:5432,Cassandra=tcp://host.containers.internal:9042,Neo4j=http://host.containers.internal:7474/,Neo4j Bolt=tcp://host.containers.internal:7687,HDFS NameNode=http://host.containers.internal:9870/"

# Directory with the runtime datasets, see server/datasets/README.md
# nosql.felk.cvut.cz: /home/yuliia/web/dbs2-task-checker-server/datasets
DATASETS_DIR=./server/datasets

# ---------------------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------------------

# Where the site is reachable.
#   :80                   -> http://<host>/            (default)
#   nosql.felk.cvut.cz    -> https://nosql.felk.cvut.cz/ (automatic certificate; needs ports
#                            80+443 reachable from the internet)
SITE_ADDRESS=:80

# Host ports published by the web service. Change if 80/443 are taken or can't be bound
# (rootless podman: see README).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Host broker setup: server/scripts/grading/README.md
GRADING_CONTROL_DIR=../grading/control
PORTAL_LOGIN_DIR=./run/login
PORTAL_LOGIN_COMMAND=portal-login
# Bump for engine/module versions or grading semantics changes.
REFERENCE_CACHE_VERSION=shared-mongo8.3.11-redis7.4.7-v1
