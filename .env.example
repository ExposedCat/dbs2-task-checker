# Copy to .env for production. Development Compose supplies its own local defaults.
# Generate separate secrets, for example with `openssl rand -hex 32`.
JWT_SECRET=change-me
GRADING_MONGO_PASSWORD=change-me
GRADING_REDIS_PASSWORD=change-me

# Portal database (users, question banks, submissions). compose.local-db.yaml supplies
# mongodb://mongo:27017 instead when using the optional local portal database.
DB_CONNECTION_URL=mongodb://host.containers.internal:27017

# Optional personal database endpoints, used only by the admin Services page.
MONGO_SANDBOX_HOST=host.containers.internal
MONGO_SANDBOX_PORT=42222
REDIS_SANDBOX_HOST=host.containers.internal

# Optional Linux account password reset; leave disabled for local development.
PASSWORD_RESET_SSH_TARGET=
PASSWORD_RESET_SSH_KEY_FILE=/dev/null
INFRA_SERVICES=

DATASETS_DIR=./server/datasets
SITE_ADDRESS=:80
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Production SSH login approval only; grading needs no host service.
PORTAL_LOGIN_DIR=./run/login
PORTAL_LOGIN_COMMAND=portal-login
REFERENCE_CACHE_VERSION=compose-scoped-v1

# Local development (compose.dev.yaml only).
# Skip authentication as student or admin; the selected demo account is created automatically.
# Ignored unless NODE_ENV=development. Production keeps SSH code approval.
FORCE_USER=student
